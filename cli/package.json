{
  "name": "streamboard",
  "version": "0.0.3",
  "description": "CLI for streamboard — list, codegen, and push live data to streamboards.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "streamboard": "./dist/index.js"
  },
  "files": [
    "dist",
    "skills"
  ],
  "scripts": {
    "prebuild": "rm -rf ./skills && cp -r ../clients/claude-code/skills ./skills",
    "build": "pnpm prebuild && tsup",
    "dev": "tsx src/index.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint ./src",
    "lint:fix": "biome lint --write ./src",
    "format": "biome format --write ./src"
  },
  "dependencies": {
    "@clack/prompts": "^0.10.0",
    "@orpc/client": "^1.13.9",
    "@streamboard/api-types": "^0.1.0",
    "@streamboard/sdk": "workspace:*",
    "citty": "^0.1.6"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.5",
    "@cloudflare/workers-types": "^4.20260313.1",
    "@types/node": "^22.0.0",
    "tsup": "^8.4.0",
    "tsx": "^4.19.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.1"
  }
}
